# Claude / Anthropic API key used by the planning, scaffolding and n8n-workflow
# agents. When unset, the agents fall back to deterministic rule-based
# generation so the app still works end-to-end without any key.
ANTHROPIC_API_KEY=

# Real n8n instance the "Deploy to n8n" button pushes generated workflows to.
# N8N_BASE_URL should point at the root of your n8n instance, e.g.
# https://n8n.example.com (the app appends /api/v1/workflows itself).
N8N_BASE_URL=
N8N_API_KEY=
