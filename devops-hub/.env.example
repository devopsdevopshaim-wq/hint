# Claude / Anthropic API key used by the planning, scaffolding and n8n-workflow
# agents. When unset, the agents fall back to deterministic rule-based
# generation so the app still works end-to-end without any key.
ANTHROPIC_API_KEY=

# Real n8n instance the "Deploy to n8n" button pushes generated workflows to.
#
# Using n8n Cloud (recommended, no server to manage):
#   N8N_BASE_URL=https://your-instance.app.n8n.cloud
#   N8N_API_KEY=<Settings -> n8n API -> Create an API key>
#   N8N_EDITOR_URL can stay empty - it defaults to N8N_BASE_URL, which is
#   already the address you open in a browser for n8n Cloud.
#
# Using the optional self-hosted n8n service in docker-compose.yml
# (`docker compose --profile self-hosted-n8n up -d`) instead:
#   N8N_BASE_URL=http://n8n:5678       (docker-network hostname)
#   N8N_EDITOR_URL=http://localhost:5678   (or your public domain)
N8N_BASE_URL=
N8N_API_KEY=
N8N_EDITOR_URL=
